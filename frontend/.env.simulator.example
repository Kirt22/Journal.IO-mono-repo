FRONTEND_ENV=simulator
API_BASE_URL=http://127.0.0.1:3001/api/v1

# Required for "Continue with Google". Missing values fail the same way as every
# other Google problem — a generic "Google sign-in could not be completed" — so
# copy the real IDs from .env.simulator rather than leaving these blank.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Dev-only: substitute worst-case localized prices on the paywalls so long
# strings can be checked without an App Store sandbox account in that country.
# One of: id | co | in | ae | jp. Blank uses the real StoreKit price.
DEV_PRICE_STOREFRONT=
