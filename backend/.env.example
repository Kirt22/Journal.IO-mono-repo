PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://journalio.app,https://www.journalio.app
GLOBAL_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=30
PUBLIC_DEMO_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_MAX=60
MONGO_STAGE=local
MONGO_URI=mongodb://localhost:27017/journal_io
LOG_FULL_MONGO_URI=false
FIELD_ENCRYPTION_MODE=disabled
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
FIELD_ENCRYPTION_KEYS_JSON=
FIELD_LOOKUP_HMAC_KEY=
FIELD_ENCRYPTION_CANARY=
FIELD_LOOKUP_HMAC_CANARY=

JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=14d
JWT_REFRESH_EXPIRES_IN=7d
AUTH_EMAIL_OTP_EXPIRES_IN=30m
AUTH_PASSWORD_RESET_EXPIRES_IN=30m
AUTH_PASSWORD_RESET_APP_URL=http://localhost:3000/reset-password
AUTH_EMAIL_DELIVERY_MODE=console
AUTH_EMAIL_FROM_ADDRESS=otp@mail.journalio.app
AUTH_EMAIL_FROM_NAME=Journal.IO
AUTH_EMAIL_REPLY_TO=
AUTH_EMAIL_HELO_HOST=localhost

RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USERNAME=resend
RESEND_SMTP_PASSWORD=replace_me

# Production Render overrides:
# AUTH_PASSWORD_RESET_APP_URL=https://api.journalio.app/reset-password
# AUTH_EMAIL_DELIVERY_MODE=smtp
# AUTH_EMAIL_FROM_ADDRESS=otp@mail.journalio.app
# AUTH_EMAIL_FROM_NAME=Journal.IO
# AUTH_EMAIL_REPLY_TO=
# AUTH_EMAIL_HELO_HOST=api.journalio.app
# RESEND_SMTP_HOST=smtp.resend.com
# RESEND_SMTP_PORT=465
# RESEND_SMTP_USERNAME=resend
# RESEND_SMTP_PASSWORD=re_xxxxxxxxx

GOOGLE_WEB_CLIENT_ID= abcd
GOOGLE_IOS_CLIENT_ID= abcd
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET= abcd
APPLE_CLIENT_ID=app.journalio

OPENAI_API_KEY=replace_me
OPENAI_RESPONSES_MODEL=gpt-5.4-mini
# Non-production only. Production never logs raw OpenAI request/response bodies.
OPENAI_DEBUG_LOGS=false
# Optional quality override for POST /guided-reflection/session-analysis only.
OPENAI_GUIDED_REFLECTION_SESSION_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_GUIDED_REFLECTION_MODEL=
OPENAI_GUIDED_REFLECTION_REASONING_EFFORT=high
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MINDMAP_ENTRY_MODEL=
OPENAI_USER_MEMORY_MODEL=
ONBOARDING_V2_RELEASE_CUTOFF=
USER_MEMORY_REFRESH_EVERY=1

# Field encryption notes:
# - FIELD_ENCRYPTION_KEYS_JSON accepts either:
#   {"key-id":"<32-byte base64 or 64-char hex secret>"}
#   or [{"id":"key-id","key":"<32-byte base64 or 64-char hex secret>"}]
# - FIELD_LOOKUP_HMAC_KEY uses the same secret format.
# - FIELD_ENCRYPTION_CANARY and FIELD_LOOKUP_HMAC_CANARY are generated from the
#   configured active key + HMAC key and are required in migration/enforced mode.

# Pattern graph — the fourth long-term-memory layer. Deterministic tiers
# (co-occurrence + temporal ordering) always run; only the refinement pass that
# names the mechanism between two patterns calls a model, and it is throttled.
OPENAI_PATTERN_GRAPH_MODEL=
# Refine once this many new entries have accumulated since the last pass.
PATTERN_GRAPH_REFINE_EVERY=5
# How far back a pattern can be treated as preceding a new one.
PATTERN_GRAPH_TEMPORAL_WINDOW_DAYS=7
# Ceilings that keep the graph from drifting into noise as it grows.
PATTERN_GRAPH_MAX_NODES=240
PATTERN_GRAPH_MAX_EDGES=600

# Ask Jade — the conversational surface over the pattern graph.
OPENAI_ASK_JADE_MODEL=
# low | medium | high | xhigh | max. Chat has to feel responsive, so low.
OPENAI_ASK_JADE_REASONING_EFFORT=low
# Per-user turn limits, counted from stored messages (no rate-limit middleware).
JADE_TURNS_PER_DAY=40
JADE_TURNS_PER_HOUR=15
# Mine a conversation into the pattern graph every N turns, and sweep chats
# left idle this many minutes so an abandoned tail is still picked up.
JADE_MINE_EVERY=8
JADE_MINE_IDLE_MINUTES=30

REVENUECAT_WEBHOOK_AUTH_TOKEN=replace_me
REVENUECAT_SECRET_API_KEY=replace_me
REVENUECAT_APP_ID=replace_me
REVENUECAT_ALLOWED_WEBHOOK_ENVIRONMENTS=PRODUCTION,SANDBOX

# Development only: default uses RevenueCat, pro forces Pro, free forces Free.
# This override is ignored when NODE_ENV=production.
DEV_PREMIUM_ACCESS_OVERRIDE=default
