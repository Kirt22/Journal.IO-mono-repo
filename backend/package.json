{
  "name": "mindwrite-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "dev:simulator": "HOST=127.0.0.1 PORT=3001 nodemon --exec ts-node src/app.ts",
    "dev:local-test": "HOST=0.0.0.0 PORT=3001 nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:simulator": "HOST=127.0.0.1 PORT=3001 node dist/app.js",
    "check:production:domains": "node scripts/check-production-domains.mjs",
    "demo:capture": "npm run build && node scripts/capture-demo-scenario.mjs",
    "seed:demo": "npm run build && node scripts/seed-demo-entries.mjs",
    "teardown:demo": "node scripts/teardown-demo-entries.mjs",
    "test": "npm run build && node scripts/run-tests.mjs && node --test scripts/demo-fixture-utils.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "devDependencies": {
    "@types/nodemon": "^1.19.6",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.9.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.7.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  }
}
